@page "/rules"
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject AdminService AdminService

<PageTitle>Rules</PageTitle>

@if (_user is null)
{
    <LoginRedirect />
}
else
{
    <div class="page-header"><h1>Rules</h1></div>
    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @_loadError
        </MudAlert>
    }
    <section class="glass-card panel confetti-card">
        <div class="rules-text">@RulesText</div>
    </section>
}

@code {
    private Participant? _user;
    private string RulesText { get; set; } = AdminService.DefaultRulesText;
    private string? _loadError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _user = await CurrentUser.GetCurrentUserAsync();

            if (_user is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            RulesText = await AdminService.GetRulesTextAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
