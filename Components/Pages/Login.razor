@page "/login"
@page "/"
@inject CurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<div class="login-page glass-card stadium-bg">
    <div class="login-panel">
        <div class="big-trophy">🏆</div>
        <h1>WORLD CUP<br />PREDICTOR</h1>
        <p>Enter your access code to login</p>

        @if (_currentUser is not null)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Logged in as <strong>@_currentUser.DisplayName</strong>.
            </MudAlert>

            <MudButton FullWidth="true"
                       Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Class="mb-4"
                       OnClick="Logout">
                LOG OUT
            </MudButton>
        }

        <MudTextField @bind-Value="_code"
                      Placeholder="Enter access code"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentIcon="@Icons.Material.Filled.Key" />
        <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="HandleLogin">LOG IN</MudButton>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }

    </div>
</div>

@code {
    private string _code = string.Empty;
    private string? _error;
    private Participant? _currentUser;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _currentUser = await CurrentUser.GetCurrentUserAsync();
        StateHasChanged();
    }

    private async Task HandleLogin()
    {
        _error = null;

        var user = await CurrentUser.LoginWithCodeAsync(_code);
        if (user is null)
        {
            _error = "Invalid access code. Check spelling or try logging out before switching user.";
            return;
        }

        Snackbar.Add($"Welcome, {user.DisplayName}!", Severity.Success);
        Navigation.NavigateTo("/dashboard", forceLoad: true);
    }

    private async Task Logout()
    {
        await CurrentUser.LogoutAsync();
        _currentUser = null;
        _code = string.Empty;
        Snackbar.Add("Logged out", Severity.Success);
    }
}
