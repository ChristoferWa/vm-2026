@page "/leaderboard"
@inject CurrentUserService CurrentUser
@inject LeaderboardService LeaderboardService
@inject NavigationManager Navigation

<PageTitle>Leaderboard</PageTitle>

@if (_rows.Count == 0)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <div class="page-header">
        <div>
            <h1>Leaderboard</h1>
            <p>Current standings based on finished matches.</p>
        </div>
    </div>

    <div class="podium-grid">
        @foreach (var row in _rows.Take(3))
        {
            <div class="podium-card glass-card @(row.IsCurrentUser ? "current-user-card" : string.Empty)">
                <div class="podium-rank">#@row.Rank</div>
                <h2>@row.ParticipantName</h2>
                <strong>@row.Points pts</strong>
                <small>@row.CorrectScore exact scores � @row.CorrectOutcome outcomes</small>
            </div>
        }
    </div>

    <section class="glass-card panel">
        <div class="leaderboard-list">
            <div class="leaderboard-list-header">
                <span>#</span>
                <span>Player</span>
                <span>Points</span>
                <span>Exact</span>
                <span>Outcome</span>
                <span>Submitted</span>
            </div>

            @foreach (var row in _rows)
            {
                <div class="leaderboard-list-row @(row.IsCurrentUser ? "current" : string.Empty)">
                    <span class="leaderboard-rank">#@row.Rank</span>
                    <strong>@row.ParticipantName</strong>
                    <span><b>@row.Points</b> pts</span>
                    <span>@row.CorrectScore exact</span>
                    <span>@row.CorrectOutcome outcomes</span>
                    <span>@row.PredictionsSubmitted submitted</span>
                </div>
            }
        </div>
    </section>
}

@code {
    private List<LeaderboardRow> _rows = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var user = await CurrentUser.GetCurrentUserAsync();

        if (user is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _rows = await LeaderboardService.GetLeaderboardAsync(user.Id);
        StateHasChanged();
    }
}
