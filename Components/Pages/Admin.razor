@page "/admin"
@inject CurrentUserService CurrentUser
@inject AdminService AdminService
@inject PredictionService PredictionService
@inject ResultSyncService ResultSyncService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Admin</PageTitle>

@if (_user is null)
{
    <LoginRedirect />
}
else if (!_user.IsAdmin)
{
    <div class="glass-card panel">
        <h1>Access denied</h1>
        <p>You do not have access to this page.</p>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1>Admin</h1>
            <p>Manage predictions and match results.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @_loadError
        </MudAlert>
    }

    <MudTabs Rounded="true" Elevation="0" Class="admin-tabs">
    <MudTabPanel Text="Predictions">
    <section class="glass-card panel admin-tab-panel">
        <h2>Predictions</h2>

        <MudAlert Severity="@(_predictionsLocked? Severity.Warning: Severity.Success)">
            Predictions are currently <strong>@(_predictionsLocked ? "locked" : "open")</strong>.
        </MudAlert>

        <MudButton Variant="Variant.Filled"
                   Color="@(_predictionsLocked ? Color.Success : Color.Warning)"
                   Disabled="_isUpdatingLock"
                   Class="mt-4"
                   OnClick="TogglePredictionsLock">
            @(_predictionsLocked ? "Unlock predictions" : "Lock predictions")
        </MudButton>
    </section>
    </MudTabPanel>

    <MudTabPanel Text="Import">
    <section class="glass-card panel admin-tab-panel">
        <h2>Excel import</h2>

        <div class="mt-4">
            <InputFile OnChange="OnImportFileSelected" accept=".xlsx" />
        </div>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Disabled="@(_isImportingTips || _selectedImportFile is null)"
                   Class="mt-4"
                   OnClick="ImportTipsWorkbook">
            @(_isImportingTips ? "Importing..." : "Import selected Excel")
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(_lastImportMessage))
        {
            <p>@_lastImportMessage</p>
        }
    </section>
    </MudTabPanel>

    <MudTabPanel Text="API results">
    <section class="glass-card panel admin-tab-panel">
        <h2>API results</h2>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Disabled="_isFetchingResults"
                   OnClick="PreviewLatestResults">
            @(_isFetchingResults ? "Fetching..." : "Fetch latest results")
        </MudButton>

        @if (_resultSyncPreview is not null)
        {
            <MudAlert Severity="@(_resultSyncPreview.Updates.Any() ? Severity.Info : Severity.Success)" Class="mt-4">
                @_resultSyncPreview.Summary
            </MudAlert>

            @if (!_resultSyncPreview.Updates.Any() && _resultSyncPreview.IgnoredApiMatches > 0)
            {
                <p class="api-sync-note">
                    The API returned finished matches, but most of them do not belong to the teams in this imported tournament.
                </p>
            }

            @if (_resultSyncPreview.Updates.Any())
            {
                <MudTable Items="_resultSyncPreview.Updates" Dense="true" Hover="true" Elevation="0" Class="mt-4">
                    <HeaderContent>
                        <MudTh>Match</MudTh>
                        <MudTh>Current</MudTh>
                        <MudTh>API</MudTh>
                        <MudTh>Source</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <strong>@context.HomeTeamName vs @context.AwayTeamName</strong>
                            <small>@context.KickoffUtc.ToLocalTime().ToString("MMM d, HH:mm")</small>
                        </MudTd>
                        <MudTd>@ScoreText(context.CurrentHomeGoals, context.CurrentAwayGoals)</MudTd>
                        <MudTd>@context.ApiHomeGoals - @context.ApiAwayGoals</MudTd>
                        <MudTd>@context.SourceMatch</MudTd>
                    </RowTemplate>
                </MudTable>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="_isApplyingResults"
                           Class="mt-4"
                           OnClick="ApplyResultUpdates">
                    @(_isApplyingResults ? "Applying..." : "Apply result updates")
                </MudButton>
            }

            @if (_resultSyncPreview.Skipped.Any())
            {
                <MudExpansionPanels Elevation="0" Class="mt-4">
                    <MudExpansionPanel Text="Show skipped API matches">
                        @foreach (var skipped in _resultSyncPreview.Skipped)
                        {
                            <div>@skipped</div>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        }
    </section>
    </MudTabPanel>

    <MudTabPanel Text="Knockout">
    <section class="glass-card panel admin-tab-panel">
        <h2>Knockout teams</h2>
        <p>Fill the next round from the winners in the previous round. If a match ended in a draw, choose the team that advanced below before filling the next round.</p>

        <div class="admin-knockout-actions">
            @foreach (var transition in KnockoutTransitions)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="_isFillingKnockout"
                           OnClick="() => FillNextRound(transition.Source, transition.Target)">
                    @($"Fill {transition.Target}")
                </MudButton>
            }
        </div>
    </section>
    </MudTabPanel>

    <MudTabPanel Text="Results">
    <section class="glass-card panel admin-tab-panel">
        <h2>Results</h2>

        @foreach (var match in _matches)
        {
            <div class="admin-result-row">
                <div>
                    <small>@match.KickoffUtc.ToLocalTime().ToString("MMM d, HH:mm")</small>
                    <strong>
                        @match.HomeTeam.FlagEmoji @match.HomeTeam.Name
                        vs
                        @match.AwayTeam.FlagEmoji @match.AwayTeam.Name
                    </strong>

                    <div class="admin-stage-controls">
                        <MudSelect T="string"
                                   Value="@GroupNameText(match.Id)"
                                   ValueChanged="value => _groupNames[match.Id] = value ?? string.Empty"
                                   Label="Stage"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   Class="stage-input">
                            @if (!StageOptions.Contains(GroupNameText(match.Id)))
                            {
                                <MudSelectItem Value="@GroupNameText(match.Id)">@GroupNameText(match.Id)</MudSelectItem>
                            }

                            @foreach (var stage in StageOptions)
                            {
                                <MudSelectItem Value="@stage">@stage</MudSelectItem>
                            }
                        </MudSelect>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   OnClick="() => SaveGroupName(match.Id)">
                            Save stage
                        </MudButton>
                    </div>
                </div>

                <MudTextField T="string"
                              Value="@KickoffText(match.Id)"
                              ValueChanged="value => _kickoffTexts[match.Id] = value"
                              Label="Kickoff"
                              Placeholder="2026-06-18 21:00"
                              Variant="Variant.Outlined"
                              Class="kickoff-input" />

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="() => SaveKickoff(match.Id)">
                    Save time
                </MudButton>

                <MudNumericField T="int?"
                                 Value="_resultHomeGoals[match.Id]"
                                 ValueChanged="value => _resultHomeGoals[match.Id] = value"
                                 Min="0"
                                 Max="30"
                                 Variant="Variant.Outlined"
                                 HideSpinButtons="true"
                                 Class="score-input admin-home-score" />

                <span class="admin-score-separator">-</span>

                <MudNumericField T="int?"
                                 Value="_resultAwayGoals[match.Id]"
                                 ValueChanged="value => _resultAwayGoals[match.Id] = value"
                                 Min="0"
                                 Max="30"
                                 Variant="Variant.Outlined"
                                 HideSpinButtons="true"
                                 Class="score-input admin-away-score" />

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="() => SaveResult(match.Id)">
                    Save
                </MudButton>

                @if (NeedsAdvancingTeam(match))
                {
                    <div class="admin-advancing-team">
                        <MudSelect T="int?"
                                   Value="@AdvancingTeamValue(match.Id)"
                                   ValueChanged="value => _advancingTeamIds[match.Id] = value"
                                   Label="Advancing team"
                                   Variant="Variant.Outlined"
                                   Dense="true">
                            <MudSelectItem T="int?" Value="@((int?)match.HomeTeamId)">@match.HomeTeam.Name</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)match.AwayTeamId)">@match.AwayTeam.Name</MudSelectItem>
                        </MudSelect>

                        <small>The selection is used when you fill the next round.</small>
                    </div>
                }
            </div>
        }
    </section>
    </MudTabPanel>

    <MudTabPanel Text="Rules">
    <section class="glass-card panel admin-tab-panel">
        <h2>Rules page</h2>

        <MudTextField T="string"
                      Value="_rulesText"
                      ValueChanged="value => _rulesText = value ?? string.Empty"
                      Label="Rules text"
                      Variant="Variant.Outlined"
                      Lines="12"
                      FullWidth="true"
                      Class="rules-admin-editor" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_isSavingRules"
                   Class="mt-4"
                   OnClick="SaveRulesText">
            @(_isSavingRules ? "Saving..." : "Save rules")
        </MudButton>
    </section>
    </MudTabPanel>
    </MudTabs>
}

@code {
    private Participant? _user;
    private bool _predictionsLocked;
    private bool _isUpdatingLock;
    private bool _isImportingTips;
    private bool _isFetchingResults;
    private bool _isApplyingResults;
    private bool _isFillingKnockout;
    private bool _isSavingRules;
    private string _rulesText = AdminService.DefaultRulesText;
    private string? _loadError;
    private string? _lastImportMessage;
    private IBrowserFile? _selectedImportFile;
    private ResultSyncPreview? _resultSyncPreview;
    private List<Match> _matches = new();
    private Dictionary<int, int?> _resultHomeGoals = new();
    private Dictionary<int, int?> _resultAwayGoals = new();
    private Dictionary<int, int?> _advancingTeamIds = new();
    private Dictionary<int, string> _kickoffTexts = new();
    private Dictionary<int, string> _groupNames = new();
    private static readonly string[] StageOptions =
    [
        "Gruppspel",
        "Sextondelsfinal",
        "Åttondelsfinal",
        "Kvartsfinal",
        "Semifinal",
        "Final"
    ];
    private static readonly (string Source, string Target)[] KnockoutTransitions =
    [
        ("Sextondelsfinal", "Åttondelsfinal"),
        ("Åttondelsfinal", "Kvartsfinal"),
        ("Kvartsfinal", "Semifinal"),
        ("Semifinal", "Final")
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _user = await CurrentUser.GetCurrentUserAsync();

            if (_user is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            _predictionsLocked = await AdminService.GetPredictionsLockedAsync();
            _rulesText = await AdminService.GetRulesTextAsync();
            await ReloadMatchesAsync();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task TogglePredictionsLock()
    {
        _isUpdatingLock = true;

        var newValue = !_predictionsLocked;
        _predictionsLocked = await AdminService.SetPredictionsLockedAsync(newValue);

        _isUpdatingLock = false;
    }

    private async Task SaveResult(int matchId)
    {
        try
        {
            await PredictionService.SaveResultAsync(
                matchId,
                _resultHomeGoals[matchId],
                _resultAwayGoals[matchId]);

            await ReloadMatchesAsync();

            Snackbar.Add("Result saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task FillNextRound(string sourceStage, string targetStage)
    {
        try
        {
            _isFillingKnockout = true;
            StateHasChanged();

            var updates = await PredictionService.FillNextKnockoutRoundAsync(sourceStage, targetStage, _advancingTeamIds);

            await ReloadMatchesAsync();

            Snackbar.Add($"{targetStage} updated with {updates} team slots", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isFillingKnockout = false;
            StateHasChanged();
        }
    }

    private async Task SaveKickoff(int matchId)
    {
        if (!_kickoffTexts.TryGetValue(matchId, out var kickoffText))
            return;

        if (!DateTime.TryParse(kickoffText, out var kickoffLocal))
        {
            Snackbar.Add("Invalid kickoff format. Use yyyy-MM-dd HH:mm", Severity.Error);
            return;
        }

        try
        {
            await PredictionService.SaveKickoffAsync(matchId, kickoffLocal.ToUniversalTime());

            await ReloadMatchesAsync();

            Snackbar.Add("Kickoff saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SaveGroupName(int matchId)
    {
        if (!_groupNames.TryGetValue(matchId, out var groupName))
            return;

        try
        {
            await PredictionService.SaveGroupNameAsync(matchId, groupName);

            await ReloadMatchesAsync();

            Snackbar.Add("Stage saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task PreviewLatestResults()
    {
        try
        {
            _isFetchingResults = true;
            _resultSyncPreview = null;
            StateHasChanged();

            _resultSyncPreview = await ResultSyncService.PreviewLatestResultsAsync();

            Snackbar.Add("Latest results fetched", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isFetchingResults = false;
            StateHasChanged();
        }
    }

    private async Task ApplyResultUpdates()
    {
        if (_resultSyncPreview is null || !_resultSyncPreview.Updates.Any())
            return;

        try
        {
            _isApplyingResults = true;
            StateHasChanged();

            var updatedCount = await ResultSyncService.ApplyUpdatesAsync(_resultSyncPreview.Updates);

            await ReloadMatchesAsync();

            _resultSyncPreview = null;
            Snackbar.Add($"{updatedCount} results updated", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isApplyingResults = false;
            StateHasChanged();
        }
    }

    private async Task SaveRulesText()
    {
        try
        {
            _isSavingRules = true;
            StateHasChanged();

            _rulesText = await AdminService.SetRulesTextAsync(_rulesText);

            Snackbar.Add("Rules saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isSavingRules = false;
            StateHasChanged();
        }
    }

    private string KickoffText(int matchId)
    {
        return _kickoffTexts.TryGetValue(matchId, out var value)
            ? value
            : string.Empty;
    }

    private static string ScoreText(int? homeGoals, int? awayGoals)
    {
        return homeGoals is null || awayGoals is null
            ? "-"
            : $"{homeGoals} - {awayGoals}";
    }

    private string GroupNameText(int matchId)
    {
        return _groupNames.TryGetValue(matchId, out var value)
            ? value
            : string.Empty;
    }

    private int? AdvancingTeamValue(int matchId)
    {
        return _advancingTeamIds.TryGetValue(matchId, out var value)
            ? value
            : null;
    }

    private static bool NeedsAdvancingTeam(Match match)
    {
        return IsKnockoutStage(match.GroupName)
            && match.HomeGoals is not null
            && match.AwayGoals is not null
            && match.HomeGoals == match.AwayGoals;
    }

    private static bool IsKnockoutStage(string groupName)
    {
        var value = groupName.Trim().ToLowerInvariant();

        return value.Contains("sextondel")
            || value.Contains("round of 32")
            || value.Contains("last 32")
            || value.Contains("åtton")
            || value.Contains("atton")
            || value.Contains("round of 16")
            || value.Contains("last 16")
            || value.Contains("kvart")
            || value.Contains("quarter")
            || value.Contains("semi")
            || value == "final"
            || value.Contains(" final");
    }

    private void OnImportFileSelected(InputFileChangeEventArgs args)
    {
        _selectedImportFile = args.File;
        _lastImportMessage = $"Selected file: {_selectedImportFile.Name}";
    }

    private async Task ImportTipsWorkbook()
    {
        if (_selectedImportFile is null)
        {
            Snackbar.Add("Select an Excel file first.", Severity.Warning);
            return;
        }

        try
        {
            _isImportingTips = true;
            _lastImportMessage = $"Import started: {_selectedImportFile.Name}";
            StateHasChanged();

            await using var uploadStream = _selectedImportFile.OpenReadStream(20 * 1024 * 1024);
            using var importStream = new MemoryStream();
            await uploadStream.CopyToAsync(importStream);
            importStream.Position = 0;

            var importResult = await AdminService.ImportTipsWorkbookAsync(importStream);

            await ReloadMatchesAsync();

            _lastImportMessage = importResult.Summary;
            Snackbar.Add("Tips imported from Excel", Severity.Success);
        }
        catch (Exception ex)
        {
            _lastImportMessage = $"Import failed: {ex.Message}";
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isImportingTips = false;
            StateHasChanged();
        }
    }

    private async Task ReloadMatchesAsync()
    {
        _matches = await PredictionService.GetMatchesForResultAdminAsync();

        foreach (var match in _matches)
        {
            _resultHomeGoals[match.Id] = match.HomeGoals;
            _resultAwayGoals[match.Id] = match.AwayGoals;
            _advancingTeamIds.TryAdd(match.Id, null);
            _kickoffTexts[match.Id] = match.KickoffUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
            _groupNames[match.Id] = match.GroupName;
        }
    }
}
