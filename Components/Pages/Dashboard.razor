@page "/dashboard"
@using VmTips.Web.Data
@inject CurrentUserService CurrentUser
@inject PredictionService Predictions
@inject LeaderboardService Leaderboard
@inject NavigationManager Navigation
<PageTitle>Dashboard</PageTitle>

@if (_user is null)
{
    <LoginRedirect />
}
else
{
    <div class="page-header">
        <div>
            <h1>Dashboard</h1>
            <p>Welcome back, @_user.DisplayName!</p>
        </div>
    </div>

    <div class="kpi-grid">
        <div class="kpi-card glass-card"><span>🏆</span><small>Points</small><strong>@_me?.Points</strong></div>
        <div class="kpi-card glass-card"><span>✅</span><small>Correct score</small><strong>@_me?.CorrectScore</strong></div>
        <div class="kpi-card glass-card"><span>🎯</span><small>Correct outcome</small><strong>@_me?.CorrectOutcome</strong></div>
        <div class="kpi-card glass-card"><span>📊</span><small>Current rank</small><strong>@CurrentRankText</strong></div>
    </div>

    <div class="dashboard-stack">
       <section class="glass-card panel">
    <h2>Today's matches - @TodayInSweden.ToString("MMM d")</h2>

    @if (TodaysMatches.Any())
    {
        @foreach (var match in TodaysMatches)
        {
            <a class="match-row" href="/matches/@match.Id">
                <span>@match.KickoffUtc.ToString("HH:mm")</span>
                <strong class="dashboard-match-team">@TeamFlagImage(match.HomeTeam) @match.HomeTeam.Name</strong>
                <span>vs</span>
                <strong class="dashboard-match-team">@TeamFlagImage(match.AwayTeam) @match.AwayTeam.Name</strong>
            </a>
        }
    }
    else
    {
        <p>No matches today.</p>
    }
</section>

        <section class="glass-card panel">
            <h2>Leaderboard (Top 5)</h2>
            @foreach (var row in _leaderboard.Take(5))
            {
                <div class="leader-row @(row.IsCurrentUser ? "current" : string.Empty)">
                    <span>@row.Rank</span>
                    <strong>@row.ParticipantName</strong>
                    <span>@row.Points pts</span>
                    <span class="leaderboard-form @FormClass(row.RankChange)">@FormText(row.RankChange)</span>
                </div>
            }
        </section>
    </div>
}

@code {
    private Participant? _user;
    private List<Match> _matches = new();
    private List<LeaderboardRow> _leaderboard = new();
    private LeaderboardRow? _me;
    private string CurrentRankText => _me is null ? "-" : $"#{_me.Rank}";
    private static DateTime TodayInSweden => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, SwedishTimeZone).Date;
    private IEnumerable<Match> TodaysMatches =>
    _matches.Where(x => x.KickoffUtc.Date == TodayInSweden);

    private static TimeZoneInfo SwedishTimeZone => _swedishTimeZone ??= GetSwedishTimeZone();
    private static TimeZoneInfo? _swedishTimeZone;

    private static TimeZoneInfo GetSwedishTimeZone()
    {
        try
        {
            return TimeZoneInfo.FindSystemTimeZoneById("Europe/Stockholm");
        }
        catch (TimeZoneNotFoundException)
        {
            return TimeZoneInfo.FindSystemTimeZoneById("W. Europe Standard Time");
        }
    }

    private static MarkupString TeamFlagImage(Team team)
    {
        var code = TeamFlags.GetFlagCode(team.Name);

        if (string.IsNullOrWhiteSpace(code))
        {
            var fallback = System.Net.WebUtility.HtmlEncode(TeamShortName(team));
            return new MarkupString($"<span class=\"team-flag-fallback\">{fallback}</span>");
        }

        return new MarkupString($"<img class=\"team-flag-img\" src=\"https://flagcdn.com/w40/{code}.png\" alt=\"\" loading=\"lazy\" />");
    }

    private static string TeamShortName(Team team) => team.Code.Length is >= 3 ? team.Code[..3].ToUpperInvariant() : team.Name;

    private static string FormText(int rankChange)
    {
        return rankChange switch
        {
            > 0 => $"▲ +{rankChange}",
            < 0 => $"▼ {rankChange}",
            _ => "–"
        };
    }

    private static string FormClass(int rankChange)
    {
        return rankChange switch
        {
            > 0 => "up",
            < 0 => "down",
            _ => "same"
        };
    }

protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender) return;
    _user = await CurrentUser.GetCurrentUserAsync();
    if (_user is null) { Navigation.NavigateTo("/login"); return; }

    _matches = await Predictions.GetMatchesWithPredictionsAsync(_user.Id);
    _leaderboard = await Leaderboard.GetLeaderboardAsync(_user.Id);
    _me = _leaderboard.FirstOrDefault(x => x.IsCurrentUser);

    StateHasChanged();
}
}
