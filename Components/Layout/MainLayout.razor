@inherits LayoutComponentBase
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-shell @(IsLoginPage ? "login-shell" : string.Empty)">
    @if (!IsLoginPage)
    {
        <div class="mobile-topbar glass-card">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           OnClick="ToggleNav" />
            <div class="mobile-brand">
                <strong>WORLD CUP</strong>
                <span>PREDICTOR</span>
            </div>
        </div>

        <button class="nav-backdrop @(_isNavOpen ? "open" : string.Empty)"
                type="button"
                aria-label="Close navigation"
                @onclick="CloseNav"></button>

        <div class="nav-drawer @(_isNavOpen ? "open" : string.Empty)">
            <NavMenu OnNavigate="CloseNav" />
        </div>
    }

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    private bool _isNavOpen;

    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#F6B51E",
            Secondary = "#2E7DFF",
            Background = "#0B1320",
            Surface = "#111B2A",
            DrawerBackground = "#0E1826",
            AppbarBackground = "#0E1826",
            TextPrimary = "#F7FAFC",
            TextSecondary = "#A8B3C2"
        }
    };

    private bool IsLoginPage
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');

            return string.IsNullOrEmpty(path) ||
                path.Equals("/login", StringComparison.OrdinalIgnoreCase);
        }
    }

    private void ToggleNav()
    {
        _isNavOpen = !_isNavOpen;
    }

    private void CloseNav()
    {
        _isNavOpen = false;
    }
}
